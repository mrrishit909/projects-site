{
  "name": "onboard-studio-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --base=${SITE_BASE:-/} && node scripts/postbuild-routes.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "golden": "tsx scripts/golden-check.ts",
    "check": "npm run typecheck && npm run golden && tsx scripts/review-check.ts",
    "e2e": "playwright test",
    "build:pages": "SITE_BASE=/projects-site/labs/onboard-studio/ npm run build"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.5.2",
    "tsx": "4.20.3",
    "typescript": "5.8.3",
    "vite": "6.3.5"
  }
}
